# modeldeck access token — copy to .env in the project folder on each device.
# The deck reads DECK_TOKEN from the environment (systemd: EnvironmentFile=,
# Termux: start-termux.sh exports it), so the YAML config needs no token.
#
# one-api channel "key" field: paste the value of DECK_TOKEN below.
DECK_TOKEN=deck-change-me
